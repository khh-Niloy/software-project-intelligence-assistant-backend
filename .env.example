PORT=5000
NODE_ENV=development
DATABASE_URL=mongodb://localhost:27017/langchain_rag
CORS_ORIGIN=http://localhost:3000

# Supabase Storage Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
SUPABASE_STORAGE_BUCKET=bucket_name

# Answer generation uses local Ollama in development and Gemini in production.
# Development: install Ollama and run `ollama pull qwen3:0.6b`.
# Production: configure GOOGLE_API_KEY or GEMINI_API_KEY; PRIMARY_MODEL is optional.
# models
GEMINI_API_KEY=your-google-api-key
PRIMARY_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# github oauth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback

# JWT Authentication
JWT_ACCESS_SECRET=your-jwt-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-jwt-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
